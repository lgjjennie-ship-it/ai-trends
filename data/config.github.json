{
  "version": "1.0",
  "ai": {
    "provider": "openai",
    "model": "glm-4-flash-250414",
    "base_url": "https://open.bigmodel.cn/api/paas/v4/",
    "api_key_env": "ZHIPU_API_KEY",
    "temperature": 0.4,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh",
      "en"
    ],
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1
  },
  "sources": {
    "github": [],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 40,
      "min_score": 50,
      "category": "ai-community"
    },
    "reddit": {
      "enabled": false
    },
    "telegram": {
      "enabled": false
    },
    "twitter": {
      "enabled": false
    },
    "rss": [
      {
        "name": "36氪",
        "url": "https://36kr.com/feed",
        "enabled": true,
        "category": "ai-media"
      }
    ],
    "openbb": {
      "enabled": false,
      "fetch_filings": false,
      "filings_provider": "sec",
      "watchlists": []
    },
    "google_news": {
      "enabled": true,
      "query": "AI OR LLM OR GPT OR Claude OR agent OR AI开源 OR AI项目 OR AI应用",
      "language": "zh",
      "country": "CN",
      "ceid": null,
      "max_results": 80,
      "category": "ai-search"
    },
    "ossinsight": {
      "enabled": false
    },
    "gdelt": {
      "enabled": false
    }
  },
  "filtering": {
    "ai_score_threshold": 6.0,
    "time_window_hours": 24,
    "max_items": 15,
    "category_groups": {
      "community": {
        "name": "社区热点",
        "limit": 5,
        "categories": ["ai-community"]
      },
      "media": {
        "name": "媒体报道",
        "limit": 4,
        "categories": ["ai-media"]
      },
      "search": {
        "name": "搜索发现",
        "limit": 4,
        "categories": ["ai-search"]
      }
    },
    "default_group": "other",
    "default_group_limit": 2
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary",
    "overview_position": "first",
    "platform": "generic",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": null,
    "request_body": {},
    "headers": ""
  }
}
